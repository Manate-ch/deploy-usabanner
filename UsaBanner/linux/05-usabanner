#!/bin/sh
# 05-usabanner - the banner after login, which pam_motd shows at every SSH and
# console login (docs/DECISIONS.md, D2 and D5). Deploy-UsaBanner installs it
# in /etc/update-motd.d. It draws this host's facts into the frame the deploy
# drew: pam_motd runs it as root, with no terminal, and every login gets the
# same text.
#
# USABANNER_ROOT (tests only) prefixes each file it reads.

root=${USABANNER_ROOT:-}
share=$root/usr/local/share/usabanner
state=$root/var/lib/usabanner
[ -r "$share/postlogin.sh" ] || exit 0

# The services facts.sh watches, as the deploy wrote them from the
# configuration: a setting a line, read as text and never run.
if [ -r "$state/login.env" ]; then
	while IFS= read -r line || [ -n "$line" ]; do
		case $line in
		USABANNER_SERVICES=*)
			USABANNER_SERVICES=${line#*=}
			export USABANNER_SERVICES
			;;
		esac
	done <"$state/login.env"
fi

exec sh "$share/postlogin.sh" "$state/postlogin.frame"

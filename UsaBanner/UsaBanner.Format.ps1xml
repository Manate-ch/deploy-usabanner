<?xml version="1.0" encoding="utf-8"?>
<!--
  UsaBanner.Format.ps1xml - how Get-UsaBanner's answer prints: a host as a
  list, with its checks, VLANs and settings a line each; a check or a VLAN
  alone as a table row. Windows PowerShell 5.1 loads this file too, so its
  script blocks are 5.1 syntax.
-->
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>UsaBanner.Status</Name>
      <ViewSelectedBy>
        <TypeName>UsaBanner.Status</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <PropertyName>HostName</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Os</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Version</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Deployed</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Healthy</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Ssh</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Services</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Checks</Label>
                <ScriptBlock>@($_.Checks | ForEach-Object { '{0,-8} {1,-20} {2}' -f $_.State, $_.Check, $_.Detail }) -join "`n"</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Vlans</Label>
                <ScriptBlock>@($_.Vlans | ForEach-Object { $mark = ''; if ($_.ThisHost) { $mark = '  (this host)' }; '{0,4} {1,-20} {2,-18} {3}{4}' -f $_.Tag, $_.Name, $_.Cidr, $_.Color, $mark }) -join "`n"</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Settings</Label>
                <ScriptBlock>@($_.Settings) -join "`n"</ScriptBlock>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>UsaBanner.Check</Name>
      <ViewSelectedBy>
        <TypeName>UsaBanner.Check</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>State</Label>
            <Width>8</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Check</Label>
            <Width>20</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Detail</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap />
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>State</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Check</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Detail</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>UsaBanner.Vlan</Name>
      <ViewSelectedBy>
        <TypeName>UsaBanner.Vlan</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Tag</Label>
            <Width>4</Width>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Name</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Cidr</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Color</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Short</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>ThisHost</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Tag</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Name</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Cidr</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Color</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Short</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>ThisHost</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>

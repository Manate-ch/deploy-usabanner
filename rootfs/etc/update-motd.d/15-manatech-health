#!/bin/sh
# 15-manatech-health - one line per problem on this host, or a single green
# line naming every check that ran and passed (so a check that silently
# stopped running shows up as missing from that line).
#
# Checks: failed systemd units, local filesystems at DISK_WARN, memory at
# MEM_WARN, each WATCH service, NTP sync, a pending reboot (which is why
# Ubuntu's 98-reboot-required can be disabled), and setup changes install.sh
# noted as waiting. Every probe is local and time-boxed: a hung network mount
# or D-Bus must not block a login.

lib=${MANATECH_ROOT:-}/usr/local/share/manatech/motd-lib.sh
[ -r "$lib" ] || exit 0
. "$lib"

problems= checked=
nl='
'

# note LEVEL TEXT - record one problem; LEVEL is warn (amber) or bad (red).
note() {
	case $1 in
	bad) problems="$problems  $MT_BAD$G_BAD$RST $2$nl" ;;
	*) problems="$problems  $MT_WARN$G_WARN$RST $2$nl" ;;
	esac
}

# ran NAME - add NAME to the list of checks shown on the all-clear line.
ran() { checked="${checked:+$checked $G_SEP }$1"; }

# Failed systemd units.
failed=$(timeout 2 systemctl list-units --state=failed --no-legend --plain 2>/dev/null | awk '{ print $1 }' | tr '\n' ' ')
failed=${failed% }
if [ -n "$failed" ]; then
	set -- $failed
	note bad "$# failed unit(s): $failed"
fi
ran units

# Local filesystems only (-l), so an unreachable NFS server cannot hang df.
disks=$(timeout 2 df -P -l -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs 2>/dev/null |
	awk -v w="$DISK_WARN" 'NR > 1 { p = $5; sub(/%/, "", p); if (p + 0 >= w) print p, $6 }')
IFS=$nl
for d in $disks; do
	pct=${d%% *}
	level=warn
	[ "$pct" -ge 95 ] && level=bad
	note "$level" "${d#* } is $pct% full"
done
unset IFS
ran "disks <$DISK_WARN%"

mem=$(mt_mem_pct)
[ "$mem" -ge "$MEM_WARN" ] && note warn "memory $mem% in use"
ran memory

for s in $WATCH; do
	if ! systemctl list-unit-files "$s.service" --no-legend 2>/dev/null | grep -q .; then
		note warn "$s is not installed (listed in WATCH)"
	elif ! timeout 2 systemctl is-active --quiet "$s"; then
		note bad "$s is $(timeout 2 systemctl is-active "$s")"
	fi
	ran "$s"
done

sync=$(timeout 2 timedatectl show -p NTPSynchronized --value 2>/dev/null)
[ "$sync" = no ] && note warn "clock is not NTP-synchronised"
ran clock

if [ -f /run/reboot-required ]; then
	pkgs=$(sort -u /run/reboot-required.pkgs 2>/dev/null | tr '\n' ' ')
	pkgs=${pkgs% }
	note warn "reboot required${pkgs:+ by: $pkgs}"
fi
ran reboot

# Setup changes waiting: install.sh writes this note for a copy whose update
# timer runs it (that timer installs new banner code, never --retire, --ssh or
# --timer). Each field is checked before it is shown: a count, options from
# install.sh's own set, and a plain absolute path.
p_opts= p_repo= p_count=
if [ -r "$MT_ROOT/var/lib/manatech/pending" ]; then
	while IFS='=' read -r key value; do
		case $key in
		options) p_opts=$value ;;
		repo) p_repo=$value ;;
		changes) p_count=$value ;;
		esac
	done <"$MT_ROOT/var/lib/manatech/pending"
fi
[ -n "$p_opts" ] || p_count=
for w in $p_opts; do
	case $w in
	--all | --retire | --ssh | --timer | --ad) ;;
	*) p_count= ;;
	esac
done
case $p_repo in
/*[!A-Za-z0-9/._-]* | '' | [!/]*) p_count= ;;
esac
case $p_count in
'' | *[!0-9]*) ;;
1) note warn "1 setup change waits: sh $p_repo/install.sh $p_opts --whatif$nl    shows it; sudo sh $p_repo/install.sh $p_opts makes it" ;;
*) note warn "$p_count setup changes wait: sh $p_repo/install.sh $p_opts --whatif$nl    shows them; sudo sh $p_repo/install.sh $p_opts makes them" ;;
esac
ran setup

# No domain controller could be contacted at all: ad-description.sh leaves
# this note, the time first, and its next good run removes it. Only the time
# is shown, and only when it is a number.
if [ -r "$MT_ROOT/var/lib/manatech/ad-unreached" ]; then
	IFS=$(printf '\t') read -r u_time u_what <"$MT_ROOT/var/lib/manatech/ad-unreached" || true
	u_when=
	case $u_time in
	'' | *[!0-9]*) ;;
	*) u_when=$(LC_ALL=C date -d "@$u_time" '+%a %H:%M' 2>/dev/null) ;;
	esac
	note warn "could not contact any domain controller${u_when:+ at $u_when}; AD role not refreshed"
fi

# demo.sh faults: sample problems so every style can be seen. Never set by pam_motd.
if [ "${MANATECH_DEMO_FAULTS:-}" = 1 ]; then
	note bad "2 failed unit(s): demo-a.service demo-b.service"
	note bad "zabbix-agent2 is inactive"
	note warn "/srv is 91% full"
	note warn "reboot required by: linux-image-6.8.0-140-generic"
fi

printf '\n'
if [ -n "$problems" ]; then
	printf '%s' "$problems"
else
	printf '  %s%s all clear%s   %s%s%s\n' "$MT_GOOD" "$G_OK" "$RST" "$MT_DIM" "$checked" "$RST"
fi
printf '\n'

#!/bin/sh
# 05-manatech-banner - the Manatech art, a welcome line, and a panel that
# summarises this host: environment badge, OS, role, uptime and load, memory,
# root disk, sessions, local time and IPv4 addresses.
#
# Replaces Ubuntu's 00-header and 50-landscape-sysinfo (see README.md).
# Reporting problems is 15-manatech-health's job; this script only describes.

lib=${MANATECH_ROOT:-}/usr/local/share/manatech/motd-lib.sh
[ -r "$lib" ] || exit 0
. "$lib"

# Art and welcome line. welcome.tsv's first row names the company, the two
# colours of its gradient and its 16-colour code; the Manatech row stands
# when the file is missing or that row is not a name, six 0-255 numbers and
# an SGR code.
art=$MT_SHARE/manatech.art
[ -r "$art" ] && awk -v mode="$COLOR" -f "$MT_SHARE/colour.awk" -f "$MT_SHARE/art.awk" "$art" "$art"
wname=Manatech wfrom='120 200 255' wto='255 200 80' w16='1;34'
if [ -r "$MT_SHARE/welcome.tsv" ]; then
	_tab=$(printf '\t')
	while IFS=$_tab read -r _n _r1 _g1 _b1 _r2 _g2 _b2 _c _x || [ -n "$_n" ]; do
		case $_n in '' | '#'*) continue ;; esac
		_ok=1
		for _v in "$_r1" "$_g1" "$_b1" "$_r2" "$_g2" "$_b2"; do
			case $_v in '' | *[!0-9]* | ????*) _ok= ;; *) [ "$_v" -le 255 ] || _ok= ;; esac
		done
		case $_c in '' | *[!0-9\;]*) _ok= ;; esac
		[ -n "$_ok" ] && wname=$_n wfrom="$_r1 $_g1 $_b1" wto="$_r2 $_g2 $_b2" w16=$_c
		break
	done <"$MT_SHARE/welcome.tsv"
fi
printf '\n  Welcome to %s\n\n' "$(mt_grad "$wname" $wfrom $wto "$w16")"

# Facts. Nothing from here on may wait on the network. pam_motd regenerates
# this at every SSH login into one shared file, /run/motd.dynamic.new, so two
# logins at once (MobaXterm's SFTP browser opens a second one) overwrite each
# other, and a login shows the other run's output only as far as it had got
# (Ubuntu bug 1686878). A pause here - a slow DNS answer - is exactly where
# such a MOTD gets cut off. So the FQDN is not looked up now: install.sh
# caches it in /var/lib/manatech/fqdn at every install and timer run, and
# without that file the banner uses the short name.
# MANATECH_HOST is demo.sh's as=NAME preview; pam_motd never sets it.
host=${MANATECH_HOST:-}
if [ -z "$host" ] && [ -r "$MT_ROOT/var/lib/manatech/fqdn" ]; then
	IFS= read -r host <"$MT_ROOT/var/lib/manatech/fqdn" || true
fi
[ -n "$host" ] || host=$(hostname)

# schema_for NAME - naming schema (schema.awk) for NAME: sets edge (the
# border colour of BORDER_BY's code), title_col (NAME with its schema letters
# tinted), decoded (the schema row) and site_name. A name outside the schema
# gives empty values and a plain bold title.
schema_for() {
	_s=$(awk -v host="$1" -v mode="$COLOR" -v by="$BORDER_BY" \
		-f "$MT_SHARE/colour.awk" -f "$MT_SHARE/schema.awk" \
		"$MT_SHARE/colors.tsv" "$MT_SHARE/schema-names.tsv" 2>/dev/null)
	edge=$(printf '%s\n' "$_s" | sed -n 1p)
	title_col=$(printf '%s\n' "$_s" | sed -n 2p)
	decoded=$(printf '%s\n' "$_s" | sed -n 3p)
	site_name=$(printf '%s\n' "$_s" | sed -n 4p)
	[ -n "$title_col" ] || title_col="$MT_BOLD$1$RST"
}
schema_for "$host"
[ -n "$edge" ] && MT_EDGE=$edge

# VLAN of the primary address (vlan.awk over the Core-VLANs table). The
# primary address is the source of the default route (route get asks the
# kernel; nothing is sent), else the first global one. MANATECH_IP is
# demo.sh's ip=A.B.C.D preview; pam_motd never sets it.
pip=${MANATECH_IP:-$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }')}
[ -n "$pip" ] || pip=$(ip -br -4 addr show scope global 2>/dev/null | awk 'NR == 1 { sub(/\/.*/, "", $3); print $3 }')
vlan=$(awk -v ip="$pip" -f "$MT_SHARE/vlan.awk" "$MT_SHARE/vlans.tsv" 2>/dev/null)
vlan_id=$(printf '%s' "$vlan" | cut -f1)
vlan_site=$(printf '%s' "$vlan" | cut -f2)
vlan_mini=$(printf '%s' "$vlan" | cut -f3)
vlan_code=$(printf '%s' "$vlan" | cut -f4)
vlan_short=$(printf '%s' "$vlan" | cut -f5)
vlan_cidr=$(printf '%s' "$vlan" | cut -f6)
vlan_name=${vlan_id:+$vlan_id-$vlan_mini}

. /etc/os-release
read -r up _ </proc/uptime
up=${up%.*}
read -r l1 l5 l15 _ </proc/loadavg
cores=$(nproc)
mem_pct=$(mt_mem_pct)
mem_txt=$(awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 }
	END { printf "%.1f of %.1f GiB", (t - a) / 1048576, t / 1048576 }' /proc/meminfo)
set -- $(timeout 2 df -P -h / 2>/dev/null | awk 'NR == 2 { sub(/%/, "", $5); print $5, $3, $2 }')
disk_pct=${1:-0} disk_used=${2:-?} disk_size=${3:-?}
users=$(who | awk '{ print $1 }' | sort -u | tr '\n' ' ')
users=${users% }
nsess=$(who | wc -l)

# row LABEL TEXT [WIDTH] - one panel line. Plain TEXT is measured and cut to
# fit; TEXT carrying colour escapes must pass its on-screen WIDTH.
vw=$((W - 13))
row() {
	_t=$2 _n=${3:-}
	if [ -z "$_n" ]; then
		[ ${#_t} -gt "$vw" ] && _t="$(printf '%s' "$_t" | cut -c1-$((vw - 1)))~"
		_n=${#_t}
	fi
	printf '%s%s%s  %s%-9s%s %s%s %s%s%s\n' "$MT_EDGE" "$G_V" "$RST" \
		"$MT_LABEL" "$1" "$RST" "$_t" "$(mt_rep ' ' $((vw - _n)))" "$MT_EDGE" "$G_V" "$RST"
}

# Badge: "<site> - <vlan>-<mini>" (HQ - 40-Servers) in the VLAN's colour (BADGE=site-vlan; the site
# from the host name, else from the VLAN row). A VLAN without a colour code
# keeps the environment colour; BADGE=env, or nothing known, shows ENV_NAME.
site=${site_name:-$vlan_site}
badge_txt=$ENV_NAME badge_col="$MT_ENV_BG$MT_ENV_FG"
if [ "$BADGE" != env ] && [ -n "$site$vlan_name" ]; then
	badge_txt=$site
	[ -n "$vlan_name" ] && badge_txt="${site:+$site - }$vlan_name"
	rgb=$(awk -F '\t' -v c="$vlan_code" 'c != "" && $2 == c { print $3, $4, $5, $6; exit }' "$MT_SHARE/colors.tsv")
	if [ -n "$rgb" ]; then
		set -- $rgb
		ink="255 255 255 97"
		[ $((($1 * 299 + $2 * 587 + $3 * 114) / 1000)) -gt 140 ] && ink="20 20 20 30"
		badge_col="$(mt_bg "$1" "$2" "$3" $(($4 + 10)))$(mt_fg $ink)"
	fi
fi

# Top border: host name on the left, badge on the right. When both do not
# fit, the domain goes first, then the badge text is cut with "~".
title=" $host " badge=" $badge_txt "
if [ $((2 + ${#title} + ${#badge})) -ge "$W" ]; then
	host=${host%%.*}
	schema_for "$host"
	title=" $host "
fi
max=$((W - 3 - ${#title}))
[ ${#badge} -gt "$max" ] && badge=" $(printf '%s' "$badge_txt" | cut -c1-$((max - 3)))~ "
fill=$((W - 2 - ${#title} - ${#badge}))

# Environment strip (ENV_SHOW contains "strip"): the full panel width in the
# environment's colour, the name spaced out like the pre-login M A N A T E C H.
case " $ENV_SHOW " in
*" strip "*)
	word=$(printf '%s' "$ENV_NAME" | sed 's/./& /g; s/ $//')
	pad=$((W + 2 - ${#word}))
	[ "$pad" -lt 0 ] && pad=0
	printf '%s%s%s%s%s\n' "$MT_BOLD$MT_ENV_BG$MT_ENV_FG" "$(mt_rep ' ' $((pad / 2)))" "$word" \
		"$(mt_rep ' ' $((pad - pad / 2)))" "$RST"
	;;
esac

printf '%s%s%s%s%s%s%s%s%s%s%s%s%s%s\n' "$MT_EDGE" "$G_TL" "$G_H" "$RST" \
	" " "$title_col" " " "$MT_EDGE" "$(mt_rep "$G_H" "$fill")" "$RST" \
	"$MT_BOLD$badge_col" "$badge" "$RST" "$MT_EDGE$G_H$G_TR$RST"

[ -n "$decoded" ] && row schema "$decoded"
[ -n "$vlan_id" ] && row vlan "$vlan_id  $vlan_short  ($vlan_cidr)"

# env row (ENV_SHOW contains "row"): the name as a tag in its colour, which
# stays readable for any colour (Black is charcoal), and where it came from.
case " $ENV_SHOW " in
*" row "*)
	src=${ENV_SRC:+from $ENV_SRC}
	src=${src:-none: prefix the AD Description}
	row env "$MT_BOLD$MT_ENV_BG$MT_ENV_FG $ENV_NAME $RST  $MT_DIM$src$RST" $((${#ENV_NAME} + 4 + ${#src}))
	;;
esac

row os "$PRETTY_NAME, kernel $(uname -r)"
# The role comes from motd.conf or the AD Description; with neither, the row
# asks for the Description instead of disappearing.
if [ -n "$ROLE" ]; then
	row role "$ROLE"
else
	row role "$MT_WARN(set this computer's AD Description)$RST" 36
fi

# Uptime and load; the 1-minute load turns amber once it exceeds the core count.
ut="$((up % 86400 / 3600))h $((up % 3600 / 60))m"
[ "$up" -ge 86400 ] && ut="$((up / 86400))d $ut"
plain="$ut   load $l1 $l5 $l15 / $cores cores"
lc=$MT_GOOD
[ "$(awk -v l="$l1" -v c="$cores" 'BEGIN { print (l > c) }')" = 1 ] && lc=$MT_WARN
row uptime "${plain%%load*}${MT_DIM}load$RST $lc$l1$RST $l5 $l15 $MT_DIM/ $cores cores$RST" ${#plain}

plain="$mem_pct%  $mem_txt"
row memory "$(mt_bar "$mem_pct" "$MEM_WARN") $(mt_level "$mem_pct" "$MEM_WARN")$mem_pct%$RST  $mem_txt" $((11 + ${#plain}))

plain="$disk_pct%  $disk_used of $disk_size"
row "disk /" "$(mt_bar "$disk_pct" "$DISK_WARN") $(mt_level "$disk_pct" "$DISK_WARN")$disk_pct%$RST  $disk_used of $disk_size" $((11 + ${#plain}))

row sessions "$nsess  ($users)"
row time "$(date '+%a %Y-%m-%d %H:%M %Z')"

# One row per interface holding a global IPv4 address, minus IFACE_HIDE
# (container bridges and the like).
label=ipv4
ips=$(ip -br -4 addr show scope global 2>/dev/null | awk -v hide="$IFACE_HIDE" '
	hide != "" && $1 ~ hide { next }
	{ a = $3; for (i = 4; i <= NF; i++) a = a " " $i; printf "%-10s %s\n", $1, a }')
[ -n "$ips" ] || ips=none
old_ifs=$IFS IFS='
'
for line in $ips; do
	row "$label" "$line"
	label=
done
IFS=$old_ifs

printf '%s%s%s%s%s\n' "$MT_EDGE" "$G_BL" "$(mt_rep "$G_H" "$W")" "$G_BR" "$RST"
